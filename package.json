{
  "name": "substance-catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned compound reference data published as a signed JSON bundle for the human-system app. Reference data only — describes no person, contains no health data.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=0.70 --test-coverage-branches=0.70 --test-coverage-functions=0.70 'tests/**/*.test.mjs'",
    "test:plain": "node --test 'tests/**/*.test.mjs'",
    "evidence": "node tools/fetch-evidence.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "license": "SEE LICENSE IN LICENSE"
}
